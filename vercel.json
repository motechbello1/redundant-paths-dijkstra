{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{figures/**,public/**,docs/**,*.ipynb,notebook_src.py,build_notebook.py,diagrams.py,app.py,serve_local.py,.streamlit/**,**/__pycache__/**}"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "figures/screen/*.png",
      "use": "@vercel/static"
    },
    {
      "src": "results/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/figures/(.*)",
      "dest": "/figures/$1"
    },
    {
      "src": "/results/(.*)",
      "dest": "/results/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
